# お名前.comのSSL設定がHTTPからHTTPSへ自動転送するため、ここではRewriteRuleを重複させない。
DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/markdown .md
  AddCharset UTF-8 .html .css .js .json .md
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; frame-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://img.shields.io; connect-src 'self'; font-src 'self' data:; form-action 'self'; manifest-src 'self'; worker-src 'none'; upgrade-insecure-requests"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"

  <FilesMatch "\.(?:html|md|json)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.(?:css|js)$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(?:ico|png|svg)$">
    Header always set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml text/css text/html text/markdown text/plain
</IfModule>
