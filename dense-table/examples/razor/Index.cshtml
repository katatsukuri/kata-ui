@page
@model IndexModel
@{
    ViewData["Title"] = "dense-table example (Razor Pages)";
}
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@picocss/pico@@2/css/pico.min.css">
    {{--
      wwwroot/kata-ui/ に dense-table.css / dense-table.js を配置してください。
      asp-append-version でキャッシュバスティングが有効になります。
    --}}
    <link rel="stylesheet" href="~/kata-ui/dense-table/dense-table.css" asp-append-version="true">
    <script type="module"  src="~/kata-ui/dense-table/dense-table.js"  asp-append-version="true"></script>
    <script src="https://unpkg.com/htmx.org@@1/dist/htmx.min.js"></script>
  </head>
  <body class="container">
    <main>
      <h1>dense-table（Razor Pages）</h1>

      <template id="dense-table-template">
        <table class="dense-table">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Role</th>
            </tr>
          </thead>
          <tbody
            hx-get="/api/rows"
            hx-target="this"
            hx-swap="innerHTML"
            hx-trigger="load">
          </tbody>
        </table>
      </template>

      <dense-table></dense-table>
    </main>
  </body>
</html>
